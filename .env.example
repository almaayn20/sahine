FATORA_API_KEY=your-fatora-api-key
FATORA_BASE_URL=https://api.fatora.io/v1
# Full origin of the live site, used to build Fatora's success/failure redirect URLs.
PUBLIC_SITE_URL=https://shahin.bh
PORT=4173

# Order notification emails (sent after a payment is confirmed as SUCCESS).
# Ask your host/mailbox provider for these — for a cPanel-hosted mailbox like
# info@shahin.bh, they're usually under Email Accounts -> Connect Devices.
SMTP_HOST=mail.shahin.bh
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=admin@shahin.bh
SMTP_PASS=your-mailbox-password
MAIL_FROM=Shahin <admin@shahin.bh>
MAIL_TO_INTERNAL=info@shahin.bh
